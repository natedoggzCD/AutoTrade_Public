# Alpaca Paper Trading Credentials
ALPACA_API_KEY=YOUR_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# OpenAI API (optional; used only as last resort)
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE

# OpenRouter API (used for YouTube daily summary synthesis)
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE

# Trading Settings
MAX_POSITIONS=50
POSITION_SIZE=1000
MIN_CASH_RESERVE=5000

# Paths (override defaults after moving project)
# Public backtest files download here via: python setup_backtest_data.py
DOWNDAY_ROOT=data\downday
AUTOTRADE_ROOT=.
